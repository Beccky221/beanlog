# 复制为 .env.local 后填写；不要把真实密钥发到聊天、HTML 或 GitHub。
DASHSCOPE_API_KEY=
# 管理员服务口令，至少16位；不要分发给受邀用户。这不是阿里云密钥。
RECOMMEND_ACCESS_TOKEN=
# 推荐入口邀请校验；由 scripts/create-recommend-invite.mjs 生成，真实值不要提交。
RECOMMEND_INVITE_HASHES=
RECOMMEND_INVITE_SESSION_SECRET=
QWEN_MODEL=qwen-flash
QWEN_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
RECOMMEND_DAILY_LIMIT=30
RECOMMEND_PORT=8787
RECOMMEND_HOST=127.0.0.1
RECOMMEND_ALLOWED_ORIGINS=null,https://beccky221.github.io
